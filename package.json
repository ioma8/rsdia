{
  "name": "lazydraw",
  "version": "0.1.0",
  "description": "Terminal ASCII diagram editor modeled on ASCIIFlow",
  "type": "module",
  "private": true,
  "bin": {
    "lazydraw": "src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "fixtures": "bun scripts/capture-fixtures.ts",
    "build": "bun build src/cli.ts --compile --outfile dist/lazydraw"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
